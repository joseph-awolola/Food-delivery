@page "/"

@using Shared.Models
@using System.Net.Http
@using System.Net.Http.Json
@inject HttpClient Client


@{
    var featuredFoodItems = new[]
    {
        new { Image = "/images/food.jpg", Title = "Signature Burger" },
        new { Image = "/images/food2.jpg", Title = "Spicy Jollof" },
        new { Image = "/images/food3.jpg", Title = "Grilled Delight" },
        new { Image = "/images/food4.jpg", Title = "Chef Special" },
        new { Image = "/images/food5.jpg", Title = "Tasty Wrap" },
        new { Image = "/images/food6.jpg", Title = "Fresh Bowl" }
    };
}

<div class="cover">

    <div class="home-container">
        <div class="search-container">
            <div class="mag-glass">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>
            <input type="text" class="search-bar" placeholder="Search for your order...">
        </div>

        <div class="food-display">
            <div class="carousel-track">
                @foreach (var item in featuredFoodItems)
                {
                    <div class="carousel-slide">
                        <img src="@item.Image" alt="@item.Title" />
                        <div class="carousel-caption">
                            <h3>@item.Title</h3>
                        </div>
                    </div>
                }
                @foreach (var item in featuredFoodItems)
                {
                    <div class="carousel-slide">
                        <img src="@item.Image" alt="@item.Title" />
                        <div class="carousel-caption">
                            <h3>@item.Title</h3>
                        </div>
                    </div>
                }
            </div>
        </div>
        <ul class="filter">
            <li>All</li>
            <li>Best sellers</li>
            <li>Recommended</li>
            <li>Recents</li>
            <li>New options</li>
        </ul>

        <div class="food-options">

        

            <div class="options-box">
                @foreach (var item in @items)
                {
                    <div class="order" @onclick="() => GoToCategory(item.Id)">
                    <div class="img-frame">
                        <img src="@item.ImgUrl" alt="hello world" />

                    </div>
                    <div class="description">
                        <div class="title">@item.ItemName</div>
                        <div class="description">This is a description</div>
                        <span class="prices">@item.Price</span>
                    </div>
                </div>
                }


            </div>
        </div>
    </div>

    <div class="order-checkout">
        <h3>Order</h3>
        <div class="order-section">
            <div class="address">
                <span class="title">Delivery location</span>
                <p>@PriLocation</p>
                <span class="location">@SecLocation</span>
            </div>
            <div class="orders">
                @foreach (CartItem el in @order)
                {
                    <div class="order">
                        <div class="order-image">
                            <img src="/images/food.jpg" alt="food image" />
                        </div>
                        <div class="description">
                            <h3>@el.ItemName</h3>
                            <span class="price">$@el.Price</span>
                        </div>
                    </div>
                }

            </div>
        </div>
        <hr>
        <div class="amount">
            <table>
                <tr>
                    <td>Order checkout</td>
                    <td>$ 23456</td>
                </tr>
                <tr>
                    <td>Delivery fee</td>
                    <td>$ 0</td>
                </tr>
                <tr>
                    <td>Total</td>
                    <td>$ 56379</td>
                </tr>
            </table>
            <hr>
            <button class="checkout">Checkout</button>
        </div>
    </div>
</div>

@code {
    public string PriLocation { get; set; } = "3B Arowolo Street";
    public string SecLocation { get; set; } = "Iwaya Yaba-Lagos";

    private List<Order>? orders;

    public List<CartItem> order { get; set; } = new List<CartItem>()
    {
        new CartItem("Hambuger", 1, 41.43),
        new CartItem("Jollof rice", 1, 53.24)
    };

    public List<CartItem> items { get; set; } = new List<CartItem>()
    {
        new CartItem("Hambuger", 1, 41.43)
        {
            ImgUrl = "/images/food.jpg"
        },
        new CartItem("Jollof rice", 1, 53.24)
        {
            ImgUrl = "/images/food2.jpg"
        },
        new CartItem("Hambuger", 1, 41.43)
        {
            ImgUrl = "/images/food3.jpg"
        },
        new CartItem("Jollof rice", 1, 53.24)
        {
            ImgUrl = "/images/food4.jpg"
        },
        new CartItem("Hambuger", 1, 41.43)
        {
            ImgUrl = "/images/food5.jpg"
        },
        new CartItem("Jollof rice", 1, 53.24)
        {
            ImgUrl = "/images/food6.jpg"
        }
    };

    public void GoToCategory(Guid id)
    {
        Console.WriteLine("Rerouting in progress");
        foreach (CartItem item in items)
        {
            if (item.Id == id)
            {
                Console.WriteLine($"Going to /food/{id}");
                @* NavManager.NavigateTo($"/food/{id}"); *@
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        orders = await Client.GetFromJsonAsync<List<Order>>("orders");
        foreach (var o in orders)
        {
            Console.WriteLine(o.Customer.Name);
        }
    }
}  